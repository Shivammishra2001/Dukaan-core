{
  "kind": "collectionType",
  "collectionName": "purchase_orders",
  "info": {
    "singularName": "purchase-order",
    "pluralName": "purchase-orders",
    "displayName": "Purchase Order",
    "description": "DATABASE_SCHEMA.md §7.2 — a pre-order/intent-to-buy, distinct from purchase-bill (the actual received-goods document, §7.3). Plain Document Service CRUD is fine here: unlike purchase-bill, creating/editing a PO never touches inventory_batches or the supplier ledger, so there's no atomicity requirement forcing a Knex-transaction service."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "store": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::store.store",
      "required": true,
      "useJoinTable": false
    },
    "supplier": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::supplier.supplier",
      "required": true,
      "useJoinTable": false
    },
    "po_no": {
      "type": "string",
      "required": true,
      "maxLength": 30
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "DRAFT",
        "SENT",
        "PARTIALLY_RECEIVED",
        "RECEIVED",
        "CANCELLED"
      ],
      "required": true,
      "default": "DRAFT"
    },
    "expected_date": {
      "type": "date"
    },
    "total_estimate_paise": {
      "type": "biginteger",
      "required": true,
      "default": "0"
    },
    "note": {
      "type": "text"
    },
    "items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::purchase-order-item.purchase-order-item",
      "mappedBy": "purchase_order"
    }
  }
}
