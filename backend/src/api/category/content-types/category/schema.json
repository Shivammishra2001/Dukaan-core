{
  "kind": "collectionType",
  "collectionName": "categories",
  "info": {
    "singularName": "category",
    "pluralName": "categories",
    "displayName": "Category",
    "description": "Minimal stub — included only because product.category is a relation in DATABASE_SCHEMA.md §3.2. Full category management is out of Milestone 1 scope."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "store": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::store.store",
      "required": true,
      "useJoinTable": false
    },
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "useJoinTable": false
    },
    "children": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::category.category",
      "mappedBy": "parent"
    },
    "name": {
      "type": "string",
      "required": true
    },
    "name_local": {
      "type": "string"
    },
    "sort_order": {
      "type": "integer",
      "required": true,
      "default": 0
    },
    "color_hex": {
      "type": "string",
      "maxLength": 7,
      "regex": "^#[0-9A-Fa-f]{6}$"
    },
    "is_active": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product.product",
      "mappedBy": "category"
    }
  }
}
