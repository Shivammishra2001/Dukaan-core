# app/api/pos/checkout/route.ts (BFF -> Strapi proxy)
STRAPI_URL=http://localhost:1337
STRAPI_SERVICE_TOKEN=tobemodified
# lib/session.ts verifies the dukaan_session cookie's JWT locally — must be
# byte-for-byte identical to backend/.env's JWT_SECRET, since both sides sign
# and verify the same token. Store/tenant context is derived from this
# verified session, never from a static default store id.
JWT_SECRET=tobemodified
